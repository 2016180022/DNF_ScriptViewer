      <!-- Loop값 조건 추가하여, 마지막 공격에서만 강제 브랜치되도록 적용 -->
      <Branch ActionName="StandbyReady_Finish" Condition="StandbyReady_FinishAttack == True &amp;&amp; !CheckBuff(@STANDBY_BUFF) &amp;&amp; LoopCount() >= 16" />

