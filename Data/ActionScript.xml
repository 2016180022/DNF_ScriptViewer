<?xml version="1.0" encoding="utf-8"?>
<!--
  DNF_ScriptViewer - 스핏파이어(여) ActionScript 뼈대 (2026-11-18)
  - 시간 단위: ms (StartTime, EndTime). 값이 비어 있는 곳은 측정 후 기입
  - Time에 Escape 입력 시, 해당 액션을 나가는 시점에 동작
  - Func 정의는 최상위의 <이름_Func> 요소, 참조는 액션 안에서 <이름_Func/> (빈 요소)
  - 속성값 안의 '<', '&'는 '&lt;', '&amp;'로 표기

  [관련 규칙]
  클라이언트에서 값을 불러오는 건 함수를 통해서 (Ex. getPlayerDirection())
  스크립트 내부에서 사용하는 Variable의 경우 값을 직접 대입 가능 (Ex. Condition="NowDirection != getPlayerDirection()")

  [임시 토큰] 데이터 작성 때 실제 값으로 바꿀 자리
  @FLASH     섬광류탄 스킬 키          @ICE       빙결류탄 스킬 키
  @BURST     파열류탄 스킬 키 (오픈 파이어 투척용, 단독 액션 없음)
  @PHOTO     포토빌라이저 스킬 키 (오픈 파이어 VP 투척용, 단독 액션 없음)
  @OPENFIRE  오픈 파이어 스킬 키       @STANDBY   스탠바이 레디 스킬 키
  @NITRO     니트로 모터 스킬 키       @LAND_HEIGHT  강제 착지 기준 높이
  @STANDBY_BUFF  스탠바이 레디 지속 시간 버프 키
  @BASIC_ATTACK  스핏파이어 기본 공격 스킬 키
  @EXPLOSIVE     폭발탄 스킬 키        @EXPLOSIVE_BUFF  폭발탄 버프 키
  @PIERCE        관통탄 스킬 키        @PIERCE_BUFF     관통탄 버프 키
  VP 조건은 SkillLearned(스킬 키 × 100 + VP) → 예: SkillLearned(@OPENFIRE01)

  [입력 커맨드] Jump, Attack, Move, Dash, NitroDown, Skill_{스킬 키}
  [액션 속성] SkillKey(없으면 None), CoolTime(스킬 액션만), Animation, StartTime/EndTime (전체 Ani에서 시작하는 지점과 끝나는 지점), ActionSpeedType (액션의 속도에 반영되는 스탯의 종류, None(고정) | CastSpeed(캐스트 속도) | AttackSpeed(공격 속도)), GuardType(None | Invincible | SuperArmor)
  * ActionSpeedType은 작성만 하고 별도로 계산하지는 않음, 따라서 항상 None으로 적용되며 EndTime == 실제 액션 스피드
  * 아니면 액션 스피드를 알고 있으니 임의의 캐스트 속도 및 공격 속도를 통해서 역산하여 값을 적용하는 방법도 고려
  * 왜 추가했냐: 조건 형식 변수의 ActionEnd()와 Time 형식 변수 ActionEnd()가 혼재해서, Time 형식 변수로 저거 대신 EndTime에 작성한 실제 완료값을 숫자로 집어넣기 위해서 추가
  * EndTime은 영상 측정값으로, ActionSpeedType은 스킬마다 지정 예정 (빈칸 = 미지정). Time 칸의 ActionEnd()는 EndTime 측정값이 들어오면 숫자로 교체
  [브랜치] <NormalBranch StartTime="" EndTime="ActionEnd()"> : StartTime~EndTime 구간에서만 브랜치
           <SuperCancelBranch StartTime="" EndTime="ActionEnd()"> : 액션 도중 캔슬 브랜치 (스킬로 평타 캔슬 등)
  [Func 방침] 공통 브랜치·AttackFrame의 Func화는 예정만 하고 최대한 묶는 작업은 지양 (처음 보는 사람이 Func를 매번 찾아가야 해서 문서 이해가 어려움).
              뷰어에서 Func를 편하게 보는 기능이 지원되면 그때 Func화 결정. Func화 후보는 "Func화 예정" 주석으로 표시
  [변수] 변수 관련 Line 정의
  <Variable Name="CharacterVariable" StartTime="120" Value="x" Condition="CheckBuff(y)" />
    - Value는 대입. 증감은 식으로 (Ex. Value="NitroStock - 1")
    - EndTime을 함께 적으면 그 구간 동안 매 틱 적용
  [공격] <AttackFrame AttackType TargetType StartTime ... Condition> 안에 <BuffFrame SkillKey BuffIndex /> (데이터 링크: 스킬의 BuffKey 목록 중 몇 번째인지)
  [높이] Height는 물리 없이 구간별 일정 속도로 근사 (점프 +, 하강 -, 공중 평타는 타격마다 감소). 값은 영상 대조 후 조정
  [Loop] LoopCount() = 같은 액션으로 연속 재진입한 횟수 (1타 = 0)
  [CoolTime] 액션의 CoolTime 속성으로 SkillInfo 쿨타임을 불러옴 (지상·공중 고정값, 스탠바이 투척은 0)
  [니트로 0] 공중에서 모든 스킬 불가. 공중 평타, 하강(액션 안 이동 가능), 니트로 하강만 가능
-->
<ActionScript>

  <!-- ===================== 캐릭터 변수 ===================== -->
  <CharacterVariables>
    <Variable Name="Height" Value="0" />                       <!-- 높이 (물리 없이 스크립트가 직접 조절) -->
    <Variable Name="NowDirection" Value="None" />              <!-- 이동·대시 중 현재 방향 -->

    <Variable Name="NitroStock" Value="8" />                   <!-- 니트로 모터 스택. 착지 시 8로 회복 -->
    <Variable Name="FlashStock" Value="3" />                   <!-- 류탄 보유 스택 (종류별) -->
    <Variable Name="IceStock" Value="3" />
    <Variable Name="BurstStock" Value="3" />
    <Variable Name="PhotonStock" Value="3" />

    <Variable Name="FlashCount" Value="0" />                   <!-- 강화 카운트 (종류별, 세 번째마다 강화) -->
    <Variable Name="IceCount" Value="0" />

    <Variable Name="StandbyReady_FinishAttack" Value="0" />    <!-- 스탠바이 레디 피니시 강제 브랜치용 변수 -->
  </CharacterVariables>

  <!-- ===================== Func 정의 ===================== -->

  <!-- ① 공중 액션 최우선: 높이 기준 이하면 강제 착지 -->
  <ForceLanding_Func>
    <Branch ActionName="Landing" Condition="Height &lt;= @LAND_HEIGHT" />
  </ForceLanding_Func>

  <!-- ② 공중 액션 전체: 스페이스바(NitroDown)로 니트로 하강 -->
  <NitroDownBranch_Func>
    <!-- 니트로 모터 스킬 (15제) 배워야지 니트로 사용 가능 -->
    <Branch ActionName="NitroDown" Condition="NitroDown &amp;&amp; SkillLearned(@NITRO)" />
  </NitroDownBranch_Func>

  <!-- ③ 일반 브랜치: 스탠바이 레디 유도 -->
  <!-- 버프가 있으면 전용 체공으로, 버프가 끝났으면(지속 시간 종료) 피니시로 -->
  <StandbyReadyBranch_Func>
    <Branch ActionName="StandbyReady_Hover" Condition="CheckBuff(@STANDBY_BUFF)" />
    <Branch ActionName="StandbyReady_Finish" Condition="StandbyReady_FinishAttack >= 1 &amp;&amp; !CheckBuff(@STANDBY_BUFF)" />
  </StandbyReadyBranch_Func>

  <!-- 지상 공용 브랜치 -->
  <GroundBranch_Func>
    <Branch ActionName="Flash_Ground" Condition="Skill_@FLASH &amp;&amp; FlashStock >= 1" />
    <Branch ActionName="Ice_Ground" Condition="Skill_@ICE &amp;&amp; IceStock >= 1" />
    <!-- 스탠바이 레디, 오픈파이어 지상 전용 액션 추가 필요 -->
    <Branch ActionName="GroundAttack" Condition="Attack" />
    <Branch ActionName="Jump" Condition="Jump" />
  </GroundBranch_Func>

  <!-- 이동 공용 브랜치 -->
  <!-- 동작 관련해서 논의 필요: 이동 중 반대 방향으로 이동, 이동 중 반대 방향으로 대시 등의 경우의 수 -->
  <MoveBranch_Func>
    <Branch ActionName="Dash" Condition="Dash" />
    <Branch ActionName="Move" Condition="Move" />
  </MoveBranch_Func>

  <!-- 공중 공용 브랜치 -->
  <!-- 니트로 스택 0이면 모든 스킬 불가. 공중 평타·하강(이동 가능)·니트로 하강만 가능 -->
  <AirBranch_Func>
    <Branch ActionName="StandbyReady_Cast" Condition="Skill_@STANDBY &amp;&amp; NitroStock >= 1" />
    <Branch ActionName="OpenFire" Condition="Skill_@OPENFIRE &amp;&amp; NitroStock >= 1" />
    <Branch ActionName="Flash_Air" Condition="Skill_@FLASH &amp;&amp; FlashStock >= 1 &amp;&amp; NitroStock >= 1" />
    <Branch ActionName="Ice_Air" Condition="Skill_@ICE &amp;&amp; IceStock >= 1 &amp;&amp; NitroStock >= 1" />
    <!-- 공중 평타는 니트로 스택 필요 없음 -->
    <Branch ActionName="AirAttack" Condition="Attack" />
  </AirBranch_Func>

  <!-- 강화 카운트: 종류별 세 번째 투척마다 강화 AttackFrame (오픈 파이어는 카운트에 영향 없음) -->
  <!-- 투척 액션 안에서 카운트 +1 → 3이면 강화 AttackFrame 적용 후 0 -->

  <!-- ===================== 기본 ===================== -->

  <Idle SkillKey="None" Animation="ani_idle" StartTime="0" EndTime="" ActionSpeedType="None" GuardType="None">
    <NormalBranch StartTime="0" EndTime="ActionEnd()">
      <!-- 지상 액션으로 브랜치 가능 -->
      <GroundBranch_Func />
      <MoveBranch_Func />
    </NormalBranch>
  </Idle>

  <Move SkillKey="None" Animation="ani_move" StartTime="0" EndTime="" ActionSpeedType="" GuardType="None">
    <!-- 현재 방향 저장 -->
    <Variable Name="NowDirection" StartTime="0" Value="getPlayerDirection()" />

    <!-- 이동 값 부여 -->
    <Move Speed="getCharacterMoveSpeed()" Direction="NowDirection" />

    <!-- 액션 이탈 시 현재 방향 초기화 -->
    <Variable Name="NowDirection" StartTime="Escape" Value="None" />

    <NormalBranch StartTime="0" EndTime="ActionEnd()">
      <GroundBranch_Func />
      <!-- 이동 중 자기 자신(Move)으로 재진입하지 않도록 MoveBranch_Func 대신 대시만 -->
      <Branch ActionName="Dash" Condition="Dash" />
      <Branch ActionName="Idle" Condition="!Move" />
    </NormalBranch>
  </Move>

  <Dash SkillKey="None" Animation="ani_dash" StartTime="0" EndTime="" ActionSpeedType="" GuardType="None">
    <!-- 현재 방향 저장 -->
    <Variable Name="NowDirection" StartTime="0" Value="getPlayerDirection()" />

    <Move Speed="1.4 * getCharacterMoveSpeed()" Direction="NowDirection" />

    <!-- 액션 이탈 시 현재 방향 초기화 -->
    <Variable Name="NowDirection" StartTime="Escape" Value="None" />

    <NormalBranch StartTime="0" EndTime="ActionEnd()">
      <Branch ActionName="Flash_Ground" Condition="Skill_@FLASH &amp;&amp; FlashStock >= 1" />
      <Branch ActionName="Ice_Ground" Condition="Skill_@ICE &amp;&amp; IceStock >= 1" />
      <Branch ActionName="Jump" Condition="Jump" />

      <!-- 대시 상태에서 공격 키 누르면 지상 공격 대신 슬라이딩 해야 하므로, Func 사용 불가 -->
      <!-- <Branch ActionName="GroundAttack" Condition="Attack" /> -->

      <!-- 대신 슬라이딩 액션은 구현 X, 브랜치만 -->
      <Branch ActionName="Sliding" Condition="Attack" />

      <!-- 대시에서 다시 대시 불가 -->
      <!-- <Branch ActionName="Dash" Condition="Dash" /> -->

      <!-- 반대 방향의 Move 입력 시 반대 방향으로 Move -->
      <Branch ActionName="Move" Condition="Move &amp;&amp; getPlayerDirection() == -NowDirection" />

      <!-- 키 떼면 정지 -->
      <Branch ActionName="Idle" Condition="!Dash" />
    </NormalBranch>
  </Dash>

  <!-- 점프: 상승 후 Down으로 -->
  <!-- ani_Jump 의 구성: 아주 약간 크라우치(준비) 후, 마지막까지 점프 자세 -->
  <Jump SkillKey="None" Animation="ani_jump" StartTime="0" EndTime="" ActionSpeedType="" GuardType="None">
    <!-- 상승: 구간 동안 매 틱 일정 속도로 증가 (물리 없이 구간별 일정 속도로 근사) -->
    <!-- 곡선에 가깝게 하려면 구간을 나눠 적음 (Ex. 5~200ms +1.2, 200~ActionEnd() +0.5). 속도 값은 세그먼트 대조 후 조정 -->
    <!-- StartTime은 임의값. 크라우치가 끝나고 점프가 시작되므로 시작 값이 필요함 -->
    <Variable Name="Height" StartTime="5" EndTime="ActionEnd()" Value="Height + 0.8" />

    <!-- 점프는 상승 동작이라 포스랜딩 넣으면 안됨 -->
    <!-- <ForceLanding_Func /> -->

    <!-- StartTime이랑 동일하게 적용해야 함 (크라우치 때에는 브랜치 불가) -->
    <NormalBranch StartTime="5" EndTime="ActionEnd()">
      <!-- 시작은 반드시 Cast를 거쳐야 함 -->
      <!-- <StandbyReadyBranch_Func /> -->
      <NitroDownBranch_Func />
      <AirBranch_Func />
      <Branch ActionName="Down" Condition="ActionEnd()" />
    </NormalBranch>
  </Jump>

  <!-- 일반 하강 -->
  <Down SkillKey="None" Animation="ani_down" StartTime="0" EndTime="" ActionSpeedType="" GuardType="None">
    <!-- 하강: 액션 내내 매 틱 일정 속도로 감소. 속도 값은 세그먼트 대조 후 조정 -->
    <Variable Name="Height" StartTime="0" EndTime="ActionEnd()" Value="Height - 0.6" />

    <!-- 일정 높이 이하에 도달하면 강제로 착지 -->
    <ForceLanding_Func />

    <NormalBranch StartTime="0" EndTime="ActionEnd()">
      <!-- 기타 공중 공격 액션에서 브랜치하지 못했을 경우를 대비한 보험용 브랜치 -->
      <StandbyReadyBranch_Func />

      <AirBranch_Func />
      <NitroDownBranch_Func />
    </NormalBranch>
  </Down>

  <!-- 니트로 하강: 아래쪽 분사는 이 액션의 고증 이펙트 (스택 무관, 소모 0) -->
  <NitroDown SkillKey="None" Animation="ani_nitro_down" StartTime="0" EndTime="" ActionSpeedType="" GuardType="None">
    <!-- 니트로 하강은 일반 하강보다 높은 속도 -->
    <Variable Name="Height" StartTime="0" EndTime="ActionEnd()" Value="Height - 1.0" />

    <!-- 일정 높이 이하에 도달하면 강제로 착지 -->
    <ForceLanding_Func />

    <NormalBranch StartTime="0" EndTime="ActionEnd()">
      <Branch ActionName="Landing" Condition="ActionEnd()" />
    </NormalBranch>
  </NitroDown>

  <!-- 착지 (일반·니트로 공용) -->
  <Landing SkillKey="None" Animation="ani_landing" StartTime="0" EndTime="" ActionSpeedType="" GuardType="None">
    <Variable Name="Height" StartTime="0" Value="0" />

    <!-- 착지 시 니트로 스택 모두 회복 -->
    <Variable Name="NitroStock" StartTime="0" Value="8" />

    <NormalBranch StartTime="0" EndTime="ActionEnd()">
      <Branch ActionName="Crouch" Condition="ActionEnd()" />
    </NormalBranch>
  </Landing>

  <!-- 크라우치 자세 (아주 짧게) -->
  <!-- WakeUp에서 바꾼 이유: 앉았다가 일어서는 것 뿐만 아니라, 점프 하기 전에 준비자세로도 써서 공통 사용 가능한 이름으로 변경 -->
  <Crouch SkillKey="None" Animation="ani_crouch" StartTime="0" EndTime="" ActionSpeedType="" GuardType="None">
    <NormalBranch StartTime="" EndTime="ActionEnd()">
      <GroundBranch_Func />
      <MoveBranch_Func />
      <Branch ActionName="Idle" Condition="ActionEnd()" />
    </NormalBranch>
  </Crouch>

  <!-- ===================== 평타 ===================== -->

  <!-- 지상 평타 1~6타 Loop: 같은 액션 안에서 Loop 횟수로 7타 진입 제어 -->
  <!-- LoopCount() = 이 액션으로 연속 재진입한 횟수 (런타임 함수, 1타 = 0) -->
  <!-- Loop 브랜치는 특정 시간대(StartTime~EndTime)에만, 키 입력(Attack)과 키 유지(KeyDown) 모두 허용 -->
  <GroundAttack SkillKey="None" Animation="ani_ground_shoot" StartTime="0" EndTime="" ActionSpeedType="" GuardType="None">
    <!-- Func화 예정: 평타 탄 AttackFrame 3종 (지상 평타·7타·공중 평타 공통) -->

    <!-- 탄 버프 X -->
    <AttackFrame AttackType="AttackArrow" TargetType="Enemy" StartTime="2" AttackRange="800" ArrowSpeed="200" PiercingMaxCount="5" PiercingPercent="60" Condition="!CheckBuff(@EXPLOSIVE_BUFF) &amp;&amp; !CheckBuff(@PIERCE_BUFF)">
      <!-- 기본 1타격만 적용 -->
      <BuffFrame SkillKey="@BASIC_ATTACK" BuffIndex="0" />
    </AttackFrame>

    <!-- 폭발탄 -->
    <!-- 관통 X, 적중 시 폭발하여 범위 타격 -->
    <AttackFrame AttackType="AttackArrow" TargetType="Enemy" StartTime="2" AttackRange="800" ArrowSpeed="200" PiercingMaxCount="0" PiercingPercent="0" Condition="CheckBuff(@EXPLOSIVE_BUFF)">
      <!-- 기본 1타격 + 폭발 적용 -->
      <BuffFrame SkillKey="@BASIC_ATTACK" BuffIndex="0" />
      <!-- 적중 시 그 자리에서 폭발하여 새롭게 공격 -->
      <!-- 반지름 길이 80, 중앙각 30의 부채꼴 범위 타격 -->
      <AttackFrame AttackType="RangeAttack" TargetType="Enemy" StartTime="0" RangeType="Round" AttackRange="80" AttackAngle="30" Offset="0, 0, 0">
        <BuffFrame SkillKey="@EXPLOSIVE" BuffIndex="0" />
      </AttackFrame>
    </AttackFrame>

    <!-- 관통탄 -->
    <!-- 공격력, 관통력, 사거리, 탄속 증가 -->
    <AttackFrame AttackType="AttackArrow" TargetType="Enemy" StartTime="2" AttackRange="960" ArrowSpeed="300" PiercingMaxCount="5" PiercingPercent="100" Condition="CheckBuff(@PIERCE_BUFF)">
      <!-- 관통탄 전용 데미지 적용 -->
      <BuffFrame SkillKey="@PIERCE" BuffIndex="0" />
    </AttackFrame>

    <!-- 평타가 나가야 브랜치 가능 -->
    <NormalBranch StartTime="3" EndTime="ActionEnd()">
      <Branch ActionName="GroundAttack_Finish" Condition="(Attack || KeyDown) &amp;&amp; LoopCount() >= 5" />
      <Branch ActionName="GroundAttack" Condition="(Attack || KeyDown) &amp;&amp; LoopCount() &lt; 5" />

      <!-- 평타를 캔슬하고 움직여지면 안되기 때문에 여기로 옮김 -->
      <MoveBranch_Func />
      <!-- ActionEnd() 조건의 브랜치는 반드시 Normal에 있어야 함 -->
      <Branch ActionName="Idle" Condition="ActionEnd()" />
    </NormalBranch>

    <!-- 스킬로는 기본 공격 슈퍼캔슬 가능 (사양) -->
    <!-- Func화 예정: 지상 스킬 슈퍼캔슬 브랜치 (GroundBranch_Func에는 평타·점프가 함께 있어 그대로 쓰면 Loop 타이밍 없이 평타가 재진입하므로 스킬만 따로 적음) -->
    <SuperCancelBranch StartTime="0" EndTime="ActionEnd()">
      <Branch ActionName="Flash_Ground" Condition="Skill_@FLASH &amp;&amp; FlashStock >= 1" />
      <Branch ActionName="Ice_Ground" Condition="Skill_@ICE &amp;&amp; IceStock >= 1" />
    </SuperCancelBranch>
  </GroundAttack>

  <!-- 지상 평타 7타 -->
  <!-- 애니메이션이 달라서 앞 타격보다 길이가 두 배 정도 김 -->
  <GroundAttack_Finish SkillKey="None" Animation="ani_ground_shoot_finish" StartTime="0" EndTime="" ActionSpeedType="" GuardType="None">
    <!-- Func화 예정: 평타 탄 AttackFrame 3종 (지상 평타·7타·공중 평타 공통) -->

    <!-- 탄 버프 X -->
    <AttackFrame AttackType="AttackArrow" TargetType="Enemy" StartTime="4" AttackRange="800" ArrowSpeed="200" PiercingMaxCount="5" PiercingPercent="60" Condition="!CheckBuff(@EXPLOSIVE_BUFF) &amp;&amp; !CheckBuff(@PIERCE_BUFF)">
      <!-- 기본 1타격만 적용 -->
      <BuffFrame SkillKey="@BASIC_ATTACK" BuffIndex="0" />
    </AttackFrame>

    <!-- 폭발탄 -->
    <!-- 관통 X, 적중 시 폭발하여 범위 타격 -->
    <AttackFrame AttackType="AttackArrow" TargetType="Enemy" StartTime="4" AttackRange="800" ArrowSpeed="200" PiercingMaxCount="0" PiercingPercent="0" Condition="CheckBuff(@EXPLOSIVE_BUFF)">
      <!-- 기본 1타격 + 폭발 적용 -->
      <BuffFrame SkillKey="@BASIC_ATTACK" BuffIndex="0" />
      <!-- 적중 시 그 자리에서 폭발하여 새롭게 공격 -->
      <!-- 반지름 길이 80, 중앙각 30의 부채꼴 범위 타격 -->
      <AttackFrame AttackType="RangeAttack" TargetType="Enemy" StartTime="0" RangeType="Round" AttackRange="80" AttackAngle="30" Offset="0, 0, 0">
        <BuffFrame SkillKey="@EXPLOSIVE" BuffIndex="0" />
      </AttackFrame>
    </AttackFrame>

    <!-- 관통탄 -->
    <!-- 공격력, 관통력, 사거리, 탄속 증가 -->
    <AttackFrame AttackType="AttackArrow" TargetType="Enemy" StartTime="4" AttackRange="960" ArrowSpeed="300" PiercingMaxCount="5" PiercingPercent="100" Condition="CheckBuff(@PIERCE_BUFF)">
      <!-- 관통탄 전용 데미지 적용 -->
      <BuffFrame SkillKey="@PIERCE" BuffIndex="0" />
    </AttackFrame>

    <NormalBranch StartTime="5" EndTime="ActionEnd()">
      <MoveBranch_Func />
      <Branch ActionName="Idle" Condition="ActionEnd()" />
    </NormalBranch>

    <!-- Func화 예정: 지상 스킬 슈퍼캔슬 브랜치 -->
    <SuperCancelBranch StartTime="0" EndTime="ActionEnd()">
      <Branch ActionName="Flash_Ground" Condition="Skill_@FLASH &amp;&amp; FlashStock >= 1" />
      <Branch ActionName="Ice_Ground" Condition="Skill_@ICE &amp;&amp; IceStock >= 1" />
    </SuperCancelBranch>
  </GroundAttack_Finish>

  <!-- 공중 평타 1~17타 Loop: 사격 반동으로 체공 (니트로 소모·이펙트 없음, 니트로 0이어도 가능), 타격마다 Height 감소 -->
  <AirAttack SkillKey="None" Animation="ani_air_shoot" StartTime="0" EndTime="" ActionSpeedType="" GuardType="None">
    <!-- Func화 예정: 평타 탄 AttackFrame 3종 (지상 평타·7타·공중 평타 공통) -->
    <!-- 지상 평타 값을 그대로 옮김. 공중 사격(아래 대각선)의 사거리·시작 시각은 측정 후 확인 -->

    <!-- 탄 버프 X -->
    <AttackFrame AttackType="AttackArrow" TargetType="Enemy" StartTime="" AttackRange="800" ArrowSpeed="200" PiercingMaxCount="5" PiercingPercent="60" Condition="!CheckBuff(@EXPLOSIVE_BUFF) &amp;&amp; !CheckBuff(@PIERCE_BUFF)">
      <BuffFrame SkillKey="@BASIC_ATTACK" BuffIndex="0" />
    </AttackFrame>

    <!-- 폭발탄 -->
    <AttackFrame AttackType="AttackArrow" TargetType="Enemy" StartTime="" AttackRange="800" ArrowSpeed="200" PiercingMaxCount="0" PiercingPercent="0" Condition="CheckBuff(@EXPLOSIVE_BUFF)">
      <BuffFrame SkillKey="@BASIC_ATTACK" BuffIndex="0" />
      <AttackFrame AttackType="RangeAttack" TargetType="Enemy" StartTime="0" RangeType="Round" AttackRange="80" AttackAngle="30" Offset="0, 0, 0">
        <BuffFrame SkillKey="@EXPLOSIVE" BuffIndex="0" />
      </AttackFrame>
    </AttackFrame>

    <!-- 관통탄 -->
    <AttackFrame AttackType="AttackArrow" TargetType="Enemy" StartTime="" AttackRange="960" ArrowSpeed="300" PiercingMaxCount="5" PiercingPercent="100" Condition="CheckBuff(@PIERCE_BUFF)">
      <BuffFrame SkillKey="@PIERCE" BuffIndex="0" />
    </AttackFrame>

    <!-- 타격 후 높이 감소 (Value="Height - 감소량") -->
    <Variable Name="Height" StartTime="" Value="" />
    <ForceLanding_Func />

    <!-- 평타가 나가야 브랜치 가능 -->
    <NormalBranch StartTime="" EndTime="ActionEnd()">
      <Branch ActionName="AirAttack" Condition="(Attack || KeyDown) &amp;&amp; LoopCount() &lt; 16" />
      <StandbyReadyBranch_Func />
      <NitroDownBranch_Func />
      <!-- ActionEnd() 조건의 브랜치는 반드시 Normal에 있어야 함 -->
      <Branch ActionName="Down" Condition="ActionEnd()" />
    </NormalBranch>

    <!-- 스킬로는 공중 평타 슈퍼캔슬 가능 (사양, 2026-11-18 인게임 확인) -->
    <!-- Func화 예정: 공중 스킬 슈퍼캔슬 브랜치 (AirBranch_Func에는 평타가 함께 있어 스킬만 따로 적음) -->
    <SuperCancelBranch StartTime="0" EndTime="ActionEnd()">
      <Branch ActionName="StandbyReady_Cast" Condition="Skill_@STANDBY &amp;&amp; NitroStock >= 1" />
      <Branch ActionName="OpenFire" Condition="Skill_@OPENFIRE &amp;&amp; NitroStock >= 1" />
      <Branch ActionName="Flash_Air" Condition="Skill_@FLASH &amp;&amp; FlashStock >= 1 &amp;&amp; NitroStock >= 1" />
      <Branch ActionName="Ice_Air" Condition="Skill_@ICE &amp;&amp; IceStock >= 1 &amp;&amp; NitroStock >= 1" />
    </SuperCancelBranch>
  </AirAttack>

  <!-- ===================== 류탄 (6개 액션, 애니는 지상/공중 2개) ===================== -->

  <!-- 섬광 지상: 니트로 소모 0, 이펙트 없음 -->
  <Flash_Ground SkillKey="@FLASH" CoolTime="" Animation="ani_ground_throw" StartTime="0" EndTime="" ActionSpeedType="" GuardType="None">
    <Variable Name="FlashStock" StartTime="0" Value="FlashStock - 1" />
    <Variable Name="FlashCount" StartTime="0" Value="FlashCount + 1" />
    <AttackFrame AttackType="" TargetType="Enemy" StartTime="" Condition="FlashCount != 3">
      <BuffFrame SkillKey="@FLASH" BuffIndex="" />
    </AttackFrame>
    <AttackFrame AttackType="" TargetType="Enemy" StartTime="" Condition="FlashCount == 3">   <!-- 강화 -->
      <BuffFrame SkillKey="@FLASH" BuffIndex="" />
    </AttackFrame>
    <Variable Name="FlashCount" StartTime="" Value="0" Condition="FlashCount == 3" />
    <NormalBranch StartTime="" EndTime="ActionEnd()">
      <GroundBranch_Func />
      <MoveBranch_Func />
      <Branch ActionName="Idle" Condition="ActionEnd()" />
    </NormalBranch>
  </Flash_Ground>

  <!-- 섬광 공중: 니트로 -1, 위쪽 분사 이펙트 (확장 1순위) -->
  <Flash_Air SkillKey="@FLASH" CoolTime="" Animation="ani_air_throw" StartTime="0" EndTime="" ActionSpeedType="" GuardType="None">
    <Variable Name="NitroStock" StartTime="0" Value="NitroStock - 1" />
    <Variable Name="FlashStock" StartTime="0" Value="FlashStock - 1" />
    <Variable Name="FlashCount" StartTime="0" Value="FlashCount + 1" />
    <AttackFrame AttackType="" TargetType="Enemy" StartTime="" Condition="FlashCount != 3">
      <BuffFrame SkillKey="@FLASH" BuffIndex="" />
    </AttackFrame>
    <AttackFrame AttackType="" TargetType="Enemy" StartTime="" Condition="FlashCount == 3">   <!-- 강화 -->
      <BuffFrame SkillKey="@FLASH" BuffIndex="" />
    </AttackFrame>
    <Variable Name="FlashCount" StartTime="" Value="0" Condition="FlashCount == 3" />
    <ForceLanding_Func />
    <NormalBranch StartTime="" EndTime="ActionEnd()">
      <StandbyReadyBranch_Func />
      <NitroDownBranch_Func />
      <AirBranch_Func />
      <Branch ActionName="Down" Condition="ActionEnd()" />
    </NormalBranch>
  </Flash_Air>

  <!-- 빙결 지상 -->
  <Ice_Ground SkillKey="@ICE" CoolTime="" Animation="ani_ground_throw" StartTime="0" EndTime="" ActionSpeedType="" GuardType="None">
    <Variable Name="IceStock" StartTime="0" Value="IceStock - 1" />
    <Variable Name="IceCount" StartTime="0" Value="IceCount + 1" />
    <AttackFrame AttackType="" TargetType="Enemy" StartTime="" Condition="IceCount != 3">
      <BuffFrame SkillKey="@ICE" BuffIndex="" />
    </AttackFrame>
    <AttackFrame AttackType="" TargetType="Enemy" StartTime="" Condition="IceCount == 3">   <!-- 강화 -->
      <BuffFrame SkillKey="@ICE" BuffIndex="" />
    </AttackFrame>
    <Variable Name="IceCount" StartTime="" Value="0" Condition="IceCount == 3" />
    <NormalBranch StartTime="" EndTime="ActionEnd()">
      <GroundBranch_Func />
      <MoveBranch_Func />
      <Branch ActionName="Idle" Condition="ActionEnd()" />
    </NormalBranch>
  </Ice_Ground>

  <!-- 빙결 공중 -->
  <Ice_Air SkillKey="@ICE" CoolTime="" Animation="ani_air_throw" StartTime="0" EndTime="" ActionSpeedType="" GuardType="None">
    <Variable Name="NitroStock" StartTime="0" Value="NitroStock - 1" />
    <Variable Name="IceStock" StartTime="0" Value="IceStock - 1" />
    <Variable Name="IceCount" StartTime="0" Value="IceCount + 1" />
    <AttackFrame AttackType="" TargetType="Enemy" StartTime="" Condition="IceCount != 3">
      <BuffFrame SkillKey="@ICE" BuffIndex="" />
    </AttackFrame>
    <AttackFrame AttackType="" TargetType="Enemy" StartTime="" Condition="IceCount == 3">   <!-- 강화 -->
      <BuffFrame SkillKey="@ICE" BuffIndex="" />
    </AttackFrame>
    <Variable Name="IceCount" StartTime="" Value="0" Condition="IceCount == 3" />
    <ForceLanding_Func />
    <NormalBranch StartTime="" EndTime="ActionEnd()">
      <StandbyReadyBranch_Func />
      <NitroDownBranch_Func />
      <AirBranch_Func />
      <Branch ActionName="Down" Condition="ActionEnd()" />
    </NormalBranch>
  </Ice_Air>

  <!-- 스탠바이 섬광: 기존 공중 투척 액션에서 류탄 스택·니트로 스택 소모 줄을 뺀 전용 액션 -->
  <!-- 지속 시간 동안 류탄 스택이 1 이하로 내려가지 않음, 쿨타임 0, 강화 카운트는 정상 증가 -->
  <!-- 버프 종료 시 피니시는 체공 액션(Hover)으로 돌아가서 처리 (StandbyReadyBranch_Func를 부르면 버프가 있는 동안 투척이 바로 끊김) -->
  <StandbyReady_Flash SkillKey="@FLASH" CoolTime="0" Animation="ani_air_throw" StartTime="0" EndTime="" ActionSpeedType="" GuardType="None">
    <Variable Name="FlashCount" StartTime="0" Value="FlashCount + 1" />
    <AttackFrame AttackType="" TargetType="Enemy" StartTime="" Condition="FlashCount != 3">
      <BuffFrame SkillKey="@FLASH" BuffIndex="" />
    </AttackFrame>
    <AttackFrame AttackType="" TargetType="Enemy" StartTime="" Condition="FlashCount == 3">   <!-- 강화 -->
      <BuffFrame SkillKey="@FLASH" BuffIndex="" />
    </AttackFrame>
    <Variable Name="FlashCount" StartTime="" Value="0" Condition="FlashCount == 3" />
    <NormalBranch StartTime="" EndTime="ActionEnd()">
      <Branch ActionName="StandbyReady_Hover" Condition="ActionEnd()" />
    </NormalBranch>
  </StandbyReady_Flash>

  <!-- 스탠바이 빙결 -->
  <StandbyReady_Ice SkillKey="@ICE" CoolTime="0" Animation="ani_air_throw" StartTime="0" EndTime="" ActionSpeedType="" GuardType="None">
    <Variable Name="IceCount" StartTime="0" Value="IceCount + 1" />
    <AttackFrame AttackType="" TargetType="Enemy" StartTime="" Condition="IceCount != 3">
      <BuffFrame SkillKey="@ICE" BuffIndex="" />
    </AttackFrame>
    <AttackFrame AttackType="" TargetType="Enemy" StartTime="" Condition="IceCount == 3">   <!-- 강화 -->
      <BuffFrame SkillKey="@ICE" BuffIndex="" />
    </AttackFrame>
    <Variable Name="IceCount" StartTime="" Value="0" Condition="IceCount == 3" />
    <NormalBranch StartTime="" EndTime="ActionEnd()">
      <Branch ActionName="StandbyReady_Hover" Condition="ActionEnd()" />
    </NormalBranch>
  </StandbyReady_Ice>

  <!-- ===================== 오픈 파이어 ===================== -->

  <!-- 니트로 -1, 니트로 이펙트 없음 (시전 섬광 색은 아이템 이펙트라 제외) -->
  <!-- 기본: 파열·빙결·섬광 2개씩. VP: 보유 스택만큼 종류별 최대 3개 추가 (첫 개 강화, 2·3번째 일반), 스택 0으로. 강화 카운트는 변화 없음 -->
  <OpenFire SkillKey="@OPENFIRE" CoolTime="" Animation="ani_openfire" StartTime="0" EndTime="" ActionSpeedType="" GuardType="None">
    <Variable Name="NitroStock" StartTime="0" Value="NitroStock - 1" />

    <!-- 기본 6개 -->
    <AttackFrame AttackType="" TargetType="Enemy" StartTime=""><BuffFrame SkillKey="@BURST" BuffIndex="" /></AttackFrame>
    <AttackFrame AttackType="" TargetType="Enemy" StartTime=""><BuffFrame SkillKey="@BURST" BuffIndex="" /></AttackFrame>
    <AttackFrame AttackType="" TargetType="Enemy" StartTime=""><BuffFrame SkillKey="@ICE" BuffIndex="" /></AttackFrame>
    <AttackFrame AttackType="" TargetType="Enemy" StartTime=""><BuffFrame SkillKey="@ICE" BuffIndex="" /></AttackFrame>
    <AttackFrame AttackType="" TargetType="Enemy" StartTime=""><BuffFrame SkillKey="@FLASH" BuffIndex="" /></AttackFrame>
    <AttackFrame AttackType="" TargetType="Enemy" StartTime=""><BuffFrame SkillKey="@FLASH" BuffIndex="" /></AttackFrame>

    <!-- VP1 추가 투척: 파열 -->
    <AttackFrame AttackType="" TargetType="Enemy" StartTime="" Condition="SkillLearned(@OPENFIRE01) &amp;&amp; BurstStock >= 1"><BuffFrame SkillKey="@BURST" BuffIndex="" /></AttackFrame>   <!-- 강화 -->
    <AttackFrame AttackType="" TargetType="Enemy" StartTime="" Condition="SkillLearned(@OPENFIRE01) &amp;&amp; BurstStock >= 2"><BuffFrame SkillKey="@BURST" BuffIndex="" /></AttackFrame>
    <AttackFrame AttackType="" TargetType="Enemy" StartTime="" Condition="SkillLearned(@OPENFIRE01) &amp;&amp; BurstStock >= 3"><BuffFrame SkillKey="@BURST" BuffIndex="" /></AttackFrame>
    <!-- VP1 추가 투척: 섬광 -->
    <AttackFrame AttackType="" TargetType="Enemy" StartTime="" Condition="SkillLearned(@OPENFIRE01) &amp;&amp; FlashStock >= 1"><BuffFrame SkillKey="@FLASH" BuffIndex="" /></AttackFrame>   <!-- 강화 -->
    <AttackFrame AttackType="" TargetType="Enemy" StartTime="" Condition="SkillLearned(@OPENFIRE01) &amp;&amp; FlashStock >= 2"><BuffFrame SkillKey="@FLASH" BuffIndex="" /></AttackFrame>
    <AttackFrame AttackType="" TargetType="Enemy" StartTime="" Condition="SkillLearned(@OPENFIRE01) &amp;&amp; FlashStock >= 3"><BuffFrame SkillKey="@FLASH" BuffIndex="" /></AttackFrame>
    <!-- VP1 추가 투척: 빙결 -->
    <AttackFrame AttackType="" TargetType="Enemy" StartTime="" Condition="SkillLearned(@OPENFIRE01) &amp;&amp; IceStock >= 1"><BuffFrame SkillKey="@ICE" BuffIndex="" /></AttackFrame>   <!-- 강화 -->
    <AttackFrame AttackType="" TargetType="Enemy" StartTime="" Condition="SkillLearned(@OPENFIRE01) &amp;&amp; IceStock >= 2"><BuffFrame SkillKey="@ICE" BuffIndex="" /></AttackFrame>
    <AttackFrame AttackType="" TargetType="Enemy" StartTime="" Condition="SkillLearned(@OPENFIRE01) &amp;&amp; IceStock >= 3"><BuffFrame SkillKey="@ICE" BuffIndex="" /></AttackFrame>
    <!-- VP1 추가 투척: 포토빌라이저 (포토빌라이저 VP 습득 시) -->
    <AttackFrame AttackType="" TargetType="Enemy" StartTime="" Condition="SkillLearned(@OPENFIRE01) &amp;&amp; SkillLearned(@PHOTO01) &amp;&amp; PhotonStock >= 1"><BuffFrame SkillKey="@PHOTO" BuffIndex="" /></AttackFrame>
    <AttackFrame AttackType="" TargetType="Enemy" StartTime="" Condition="SkillLearned(@OPENFIRE01) &amp;&amp; SkillLearned(@PHOTO01) &amp;&amp; PhotonStock >= 2"><BuffFrame SkillKey="@PHOTO" BuffIndex="" /></AttackFrame>
    <AttackFrame AttackType="" TargetType="Enemy" StartTime="" Condition="SkillLearned(@OPENFIRE01) &amp;&amp; SkillLearned(@PHOTO01) &amp;&amp; PhotonStock >= 3"><BuffFrame SkillKey="@PHOTO" BuffIndex="" /></AttackFrame>

    <!-- VP1: 보유 류탄 스택 0 (AttackFrame 판정 이후 시점) -->
    <Variable Name="BurstStock" StartTime="" Value="0" Condition="SkillLearned(@OPENFIRE01)" />
    <Variable Name="FlashStock" StartTime="" Value="0" Condition="SkillLearned(@OPENFIRE01)" />
    <Variable Name="IceStock" StartTime="" Value="0" Condition="SkillLearned(@OPENFIRE01)" />
    <Variable Name="PhotonStock" StartTime="" Value="0" Condition="SkillLearned(@OPENFIRE01) &amp;&amp; SkillLearned(@PHOTO01)" />

    <ForceLanding_Func />
    <NormalBranch StartTime="" EndTime="ActionEnd()">
      <StandbyReadyBranch_Func />
      <NitroDownBranch_Func />
      <AirBranch_Func />
      <Branch ActionName="Down" Condition="ActionEnd()" />
    </NormalBranch>
  </OpenFire>

  <!-- ===================== 스탠바이 레디 ===================== -->

  <!-- 시전 (공중): 액션 자체 무적 (표시용) -->
  <StandbyReady_Cast SkillKey="@STANDBY" CoolTime="" Animation="ani_standby_cast" StartTime="0" EndTime="" ActionSpeedType="" GuardType="Invincible">
    <Variable Name="StandbyReady_FinishAttack" StartTime="0" Value="StandbyReady_FinishAttack + 1" />
    <BuffFrame StartTime="" SkillKey="@STANDBY" BuffIndex="" />   <!-- 지속 시간 버프 -->
    <NormalBranch StartTime="" EndTime="ActionEnd()">
      <Branch ActionName="StandbyReady_Hover" Condition="ActionEnd()" />
    </NormalBranch>
  </StandbyReady_Cast>

  <!-- 전용 체공: 분사는 이 액션의 고증 이펙트 (스택 무관). 투척 키를 누르고 있으면 투척과 빠르게 왕복 -->
  <StandbyReady_Hover SkillKey="None" Animation="ani_standby_hover" StartTime="0" EndTime="" ActionSpeedType="" GuardType="None">
    <NormalBranch StartTime="0" EndTime="ActionEnd()">
      <!-- 체공 액션 자신으로 다시 브랜치하지 않도록 StandbyReadyBranch_Func 대신 피니시 줄만 둠 -->
      <Branch ActionName="StandbyReady_Finish" Condition="StandbyReady_FinishAttack >= 1 &amp;&amp; !CheckBuff(@STANDBY_BUFF)" />
      <Branch ActionName="StandbyReady_Flash" Condition="Skill_@FLASH || (KeyDown &amp;&amp; Skill_@FLASH)" />
      <Branch ActionName="StandbyReady_Ice" Condition="Skill_@ICE || (KeyDown &amp;&amp; Skill_@ICE)" />
    </NormalBranch>
  </StandbyReady_Hover>

  <!-- 피니시: 무적, 짧게, 타이밍 제한 없이 모든 액션으로 브랜치 -->
  <StandbyReady_Finish SkillKey="@STANDBY" Animation="ani_standby_finish" StartTime="0" EndTime="" ActionSpeedType="" GuardType="Invincible">
    <Variable Name="StandbyReady_FinishAttack" StartTime="0" Value="0" />
    <AttackFrame AttackType="" TargetType="Enemy" StartTime="">
      <BuffFrame SkillKey="@STANDBY" BuffIndex="" />
    </AttackFrame>
    <ForceLanding_Func />
    <NormalBranch StartTime="0" EndTime="ActionEnd()">
      <NitroDownBranch_Func />
      <AirBranch_Func />
      <Branch ActionName="Down" Condition="ActionEnd()" />
    </NormalBranch>
  </StandbyReady_Finish>

</ActionScript>
