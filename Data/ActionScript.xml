      <BuffFrame SkillKey="@ICE" BuffIndex="2 1" />
    </AttackFrame>

    <NormalBranch StartTime="" EndTime="ActionEnd()">
      <!-- 액션이 이미 브랜치되었다면, 공격을 마치고 나서 강제 착지 -->
      <ForceLanding_Func />

      <!-- 스바레 섬광/빙결은 별도 액션이 있으므로 일반 액션에서는 브랜치X -->
      <NitroDownBranch_Func />
      <AirBranch_Func />
      <Branch ActionName="Down" Condition="ActionEnd()" />
    </NormalBranch>
  </Ice_Air>

  <!-- 스탠바이 섬광 -->
  <!-- 류탄 스택이 1 이하로 내려가지 않음, 쿨타임 0, 강화 카운트는 정상 증가 -->
  <StandbyReady_Flash SkillKey="@FLASH" CoolTime="0" Animation="ani_air_throw" StartTime="0" EndTime="" ActionSpeedType="CastSpeed" GuardType="None">
    <!-- 류탄 스택이 2 이상일 때에만 1감소, 강화 카운트 1증가 -->
    <Variable Name="FlashStock" StartTime="0" Value="FlashStock - 1" Condition="FlashStock >= 2"/>
    <Variable Name="FlashCount" StartTime="0" Value="FlashCount + 1" />

    <!-- 강화 공격 시, 강화 카운트 초기화 (액션을 나갈 때. 액션 동안은 카운트 유지 → AttackFrame이 강화 여부를 판정) -->
    <Variable Name="FlashCount" StartTime="Escape" Value="0" Condition="FlashCount >= 3" />

    <!-- 일반 류탄 원형 범위 공격 -->
    <!-- 반지름 75px 원형, 투척 이펙트에 맞춰서 전방 150px 오프셋 적용 -->
    <AttackFrame AttackType="AttackRange" TargetType="Enemy" StartTime="" RangeType="Round" AttackRange="75" AttackAngle="360" Offset="150, 0, 0" Condition="FlashCount &lt; 3">
      <!-- 류탄 폭발 공격력 (0), 섬광 류탄 감전 공격력 (1) -->
      <BuffFrame SkillKey="@FLASH" BuffIndex="0 1" />
    </AttackFrame>

    <!-- 강화 류탄 사각 범위 공격 -->
    <!-- 현재 강화 카운트가 3 이상이면 강화 AttackFrame 적용 -->
    <!-- 밑변 150, 높이 100의 사각형 범위에 3초간 0.5초마다 지속 공격 -->
    <AttackFrame AttackType="RepeatAttack" TargetType="Enemy" StartTime="" EndTime="3000" RepeatTick="500" RangeType="Rect" RangeWidth="150" RangeHeight="100" Offset="150, 0, 0" Condition="FlashCount >= 3">
      <!-- 강화 류탄 지속 공격력 (2), 섬광 류탄 감전 공격력 (1) -->
      <BuffFrame SkillKey="@FLASH" BuffIndex="2 1" />
    </AttackFrame>
    
    <NormalBranch StartTime="" EndTime="ActionEnd()">
      <Branch ActionName="StandbyReady_Hover" Condition="ActionEnd()" />
    </NormalBranch>
  </StandbyReady_Flash>

  <!-- 스탠바이 빙결 -->
  <!-- 류탄 스택이 1 이하로 내려가지 않음, 쿨타임 0, 강화 카운트는 정상 증가 -->
  <StandbyReady_Ice SkillKey="@ICE" CoolTime="0" Animation="ani_air_throw" StartTime="0" EndTime="" ActionSpeedType="CastSpeed" GuardType="None">
    <!-- 류탄 스택이 2 이상일 때에만 1감소, 강화 카운트 1증가 -->
    <Variable Name="IceStock" StartTime="0" Value="IceStock - 1" Condition="IceStock >= 2"/>
    <Variable Name="IceCount" StartTime="0" Value="IceCount + 1" />

    <!-- 강화 공격 시, 강화 카운트 초기화 (액션을 나갈 때. 액션 동안은 카운트 유지 → AttackFrame이 강화 여부를 판정) -->
    <Variable Name="IceCount" StartTime="Escape" Value="0" Condition="IceCount >= 3" />

    <!-- 일반 류탄 원형 범위 공격 -->
    <!-- 반지름 75px 원형, 투척 이펙트에 맞춰서 전방 150px 오프셋 적용 -->
    <AttackFrame AttackType="AttackRange" TargetType="Enemy" StartTime="" RangeType="Round" AttackRange="75" AttackAngle="360" Offset="150, 0, 0" Condition="IceCount &lt; 3">
      <!-- 류탄 폭발 공격력 (0), 빙결 류탄 빙결 효과 (1) -->
      <BuffFrame SkillKey="@ICE" BuffIndex="0 1" />
    </AttackFrame>

    <!-- 강화 류탄 사각 범위 공격 -->
    <!-- 현재 강화 카운트가 3 이상이면 강화 AttackFrame 적용 -->
    <!-- 밑변 150, 높이 100의 사각형 범위에 3초간 0.5초마다 지속 공격 -->
    <AttackFrame AttackType="RepeatAttack" TargetType="Enemy" StartTime="" EndTime="3000" RepeatTick="500" RangeType="Rect" RangeWidth="150" RangeHeight="100" Offset="150, 0, 0" Condition="IceCount >= 3">
      <!-- 강화 류탄 지속 공격력 (2), 빙결 류탄 빙결 효과 (1) -->
      <BuffFrame SkillKey="@ICE" BuffIndex="2 1" />
    </AttackFrame>

    <NormalBranch StartTime="" EndTime="ActionEnd()">
      <Branch ActionName="StandbyReady_Hover" Condition="ActionEnd()" />
    </NormalBranch>
  </StandbyReady_Ice>

  <!-- ===================== 오픈 파이어 ===================== -->

  <!-- 오픈 파이어 지상 시전 액션: 지상에서 점프해 높이를 올린 뒤 바로 오픈 파이어로 강제 브랜치 -->
  <!-- 공격 없음. 애니는 스탠바이 레디 지상 시전과 같은 점프 애니. 준비 액션이라 쿨타임은 None(오픈 파이어에서 시작) -->
  <OpenFire_Jump SkillKey="@OPENFIRE" CoolTime="None" Animation="ani_skill_jump" StartTime="0" EndTime="" ActionSpeedType="None" GuardType="SuperArmor">
    <!-- 상승 (값은 영상 대조 후 조정) -->
    <Variable Name="Height" StartTime="0" EndTime="ActionEnd()" Value="Height + 0.8" />

    <NormalBranch StartTime="" EndTime="ActionEnd()">
      <Branch ActionName="OpenFire" Condition="ActionEnd()" />
    </NormalBranch>
  </OpenFire_Jump>

  <!-- 기본: 파열·빙결·섬광 2개씩. VP: 보유 스택만큼 종류별 최대 3개 추가 (첫 개 강화, 2·3번째 일반), 스택 0으로. 강화 카운트는 변화 없음 -->
  <!-- 공중제비 도는 Ani는 모두 서머솔트 Ani(ani_somersault)로 통합하여 사용 (오픈 파이어, 스바레 공중 캐스팅) -->
  <!-- 지상에서 시전하면 OpenFire_Jump(점프)를 거쳐 들어옴. 쿨타임은 이 액션에서 시작 -->
  <OpenFire SkillKey="@OPENFIRE" CoolTime="getSkillCoolTime(@OPENFIRE)" Animation="ani_somersault" StartTime="0" EndTime="" ActionSpeedType="CastSpeed" GuardType="SuperArmor">
    <!-- 니트로 모터 스택 1 감소 -->
    <Variable Name="NitroStock" StartTime="0" Value="NitroStock - 1" />

    <!-- 밑변 1200, 높이 600의 사각형 범위에 기본 6타격 -->
    <AttackFrame AttackType="AttackRange" TargetType="Enemy" StartTime="0" RangeType="Rect" RangeWidth="1200" RangeHeight="600" Offset="600, 0, 0">
      <!-- 0.2초마다 1타격씩 총 6타격 -->
      <BuffFrame SkillKey="@OPENFIRE" BuffIndex="0(200) 0(400) 0(600) 0(800) 0(1000) 0(1200)" />
    </AttackFrame>

    <!-- VP1 채택 시, 류탄 일괄 투척 -->
    <!-- 현재 류탄 스택 반영, 섬광 및 빙결은 강화 투척도 적용 -->
    <!-- VP1 추가 투척: 파열 -->
    <AttackFrame AttackType="AttackRange" TargetType="Enemy" StartTime="0" RangeType="Round" AttackRange="75" AttackAngle="360" Offset="150, 0, 0" Condition="SkillLearned(@OPENFIRE01) &amp;&amp; BurstStock >= 1">
      <BuffFrame SkillKey="@BURST" StartTime="200" BuffIndex="0" />
      <!-- 1보다 높은 류탄 스택만큼 파열류탄 데미지 추가 적용, 최대 3스택 -->
      <BuffFrame SkillKey="@BURST" StartTime="200" BuffIndex="0" Condition="BurstStock >= 2" />
      <BuffFrame SkillKey="@BURST" StartTime="200" BuffIndex="0" Condition="BurstStock >= 3" />

      <!-- 류탄 스택 0으로 초기화 (액션을 나갈 때. 그 전까지 추가 피해 조건이 원래 스택 수를 봄) -->
      <Variable Name="BurstStock" StartTime="Escape" Value="0" />
    </AttackFrame>

    <!-- VP1 추가 투척: 섬광 -->
    <!-- 1스택에 강화 류탄 적용 -->
    <AttackFrame AttackType="RepeatAttack" TargetType="Enemy" StartTime="0" EndTime="3000" RepeatTick="500" RangeType="Rect" RangeWidth="150" RangeHeight="100" Offset="150, 0, 0" Condition="SkillLearned(@OPENFIRE01) &amp;&amp; FlashStock >= 1">
      <BuffFrame SkillKey="@FLASH" StartTime="200" BuffIndex="2 1" />

      <!-- 류탄 스택 0으로 초기화 (1스택 이상이면 항상 실행되도록 이 AttackFrame에 둠, 액션을 나갈 때) -->
      <Variable Name="FlashStock" StartTime="Escape" Value="0" />
    </AttackFrame>

    <!-- 2스택부터 일반 류탄 적용 -->
    <AttackFrame AttackType="AttackRange" TargetType="Enemy" StartTime="0" RangeType="Round" AttackRange="75" AttackAngle="360" Offset="150, 0, 0" Condition="SkillLearned(@OPENFIRE01) &amp;&amp; FlashStock >= 2">
      <BuffFrame SkillKey="@FLASH" StartTime="200" BuffIndex="0 1" />
      <BuffFrame SkillKey="@FLASH" StartTime="200" BuffIndex="0 1" Condition="FlashStock >= 3" />
    </AttackFrame>

    <!-- VP1 추가 투척: 빙결 (섬광과 같은 구조) -->
    <!-- 1스택에 강화 류탄 적용 -->
    <AttackFrame AttackType="RepeatAttack" TargetType="Enemy" StartTime="0" EndTime="3000" RepeatTick="500" RangeType="Rect" RangeWidth="150" RangeHeight="100" Offset="150, 0, 0" Condition="SkillLearned(@OPENFIRE01) &amp;&amp; IceStock >= 1">
      <BuffFrame SkillKey="@ICE" StartTime="200" BuffIndex="2 1" />

      <!-- 류탄 스택 0으로 초기화 (1스택 이상이면 항상 실행되도록 이 AttackFrame에 둠, 액션을 나갈 때) -->
      <Variable Name="IceStock" StartTime="Escape" Value="0" />
    </AttackFrame>

    <!-- 2스택부터 일반 류탄 적용 -->
    <AttackFrame AttackType="AttackRange" TargetType="Enemy" StartTime="0" RangeType="Round" AttackRange="75" AttackAngle="360" Offset="150, 0, 0" Condition="SkillLearned(@OPENFIRE01) &amp;&amp; IceStock >= 2">
      <BuffFrame SkillKey="@ICE" StartTime="200" BuffIndex="0 1" />
      <BuffFrame SkillKey="@ICE" StartTime="200" BuffIndex="0 1" Condition="IceStock >= 3" />
    </AttackFrame>

    <!-- VP1 추가 투척: 포토빌라이저 (포토빌라이저 VP 습득 시, 파열과 같은 구조. 범위는 스킬 조회 후 확인) -->
    <AttackFrame AttackType="AttackRange" TargetType="Enemy" StartTime="0" RangeType="Round" AttackRange="75" AttackAngle="360" Offset="150, 0, 0" Condition="SkillLearned(@OPENFIRE01) &amp;&amp; SkillLearned(@PHOTO01) &amp;&amp; PhotonStock >= 1">
      <BuffFrame SkillKey="@PHOTO" StartTime="200" BuffIndex="0" />
      <!-- 1보다 높은 류탄 스택만큼 포토빌라이저 데미지 추가 적용, 최대 3스택 -->
      <BuffFrame SkillKey="@PHOTO" StartTime="200" BuffIndex="0" Condition="PhotonStock >= 2" />
      <BuffFrame SkillKey="@PHOTO" StartTime="200" BuffIndex="0" Condition="PhotonStock >= 3" />

      <!-- 류탄 스택 0으로 초기화 (액션을 나갈 때. 그 전까지 추가 피해 조건이 원래 스택 수를 봄) -->
      <Variable Name="PhotonStock" StartTime="Escape" Value="0" />
    </AttackFrame>

    <!-- VP1: 보유 류탄 스택 0 (AttackFrame 판정 이후 시점) -->
    <!-- 동작 자체는 동일하나, '투척'으로 인해서 '스택 소모' 라는 결과가 나오는 것이기 때문에 류탄 스택을 초기화하는 Line을 각 류탄 투척 Line 안에 종속적으로 존재하게 배치   -->
    <!-- <Variable Name="BurstStock" StartTime="" Value="0" Condition="SkillLearned(@OPENFIRE01)" />
    <Variable Name="FlashStock" StartTime="" Value="0" Condition="SkillLearned(@OPENFIRE01)" />
    <Variable Name="IceStock" StartTime="" Value="0" Condition="SkillLearned(@OPENFIRE01)" />
    <Variable Name="PhotonStock" StartTime="" Value="0" Condition="SkillLearned(@OPENFIRE01) &amp;&amp; SkillLearned(@PHOTO01)" /> -->

    <ForceLanding_Func />

    <NormalBranch StartTime="200" EndTime="ActionEnd()">
      <!-- 스탠바이 레디 유도: 버프가 있으면 체공으로, 버프가 끝났으면(지속 시간 종료) 피니시로 -->
      <Branch ActionName="StandbyReady_Hover" Condition="CheckBuff(@STANDBY_BUFF)" />
      <Branch ActionName="StandbyReady_Finish" Condition="StandbyReady_FinishAttack == True &amp;&amp; !CheckBuff(@STANDBY_BUFF)" />
      <NitroDownBranch_Func />
      <AirBranch_Func />
      <Branch ActionName="Down" Condition="ActionEnd()" />
    </NormalBranch>
  </OpenFire>

  <!-- ===================== 스탠바이 레디 ===================== -->

  <!-- 스탠바이 레디 지상 시전 액션 (점프 애니는 오픈 파이어 지상 시전과 공용) -->
  <StandbyReady_Jump SkillKey="@STANDBY" CoolTime="getSkillCoolTime(@STANDBY)" Animation="ani_skill_jump" StartTime="0" EndTime="" ActionSpeedType="None" GuardType="Invincible">
    <!-- 상승 (값은 영상 대조 후 조정) -->
    <Variable Name="Height" StartTime="0" EndTime="ActionEnd()" Value="Height + 0.8" />

    <!-- 피니시 공격 제어용 변수 활성화 -->
    <Variable Name="StandbyReady_FinishAttack" StartTime="0" Value="True" />
    <!-- 스탠바이 레디 지속시간 제어용 버프 부여 -->
    <BuffFrame StartTime="0" SkillKey="@STANDBY" BuffIndex="1" />

    <NormalBranch StartTime="" EndTime="ActionEnd()">
      <Branch ActionName="StandbyReady_Hover" Condition="ActionEnd()" />
    </NormalBranch>
  </StandbyReady_Jump>

  <!-- 스탠바이 레디 공중 시전 액션 (서머솔트 애니) -->
  <StandbyReady_Cast SkillKey="@STANDBY" CoolTime="getSkillCoolTime(@STANDBY)" Animation="ani_somersault" StartTime="0" EndTime="" ActionSpeedType="None" GuardType="Invincible">
    <!-- 피니시 공격 제어용 변수 활성화 -->
    <Variable Name="StandbyReady_FinishAttack" StartTime="0" Value="True" />
    <!-- 스탠바이 레디 지속시간 제어용 버프 부여 -->
    <BuffFrame StartTime="0" SkillKey="@STANDBY" BuffIndex="1" />
    
    <NormalBranch StartTime="" EndTime="ActionEnd()">
      <Branch ActionName="StandbyReady_Hover" Condition="ActionEnd()" />
    </NormalBranch>
  </StandbyReady_Cast>

  <!-- 스탠바이 레디 체공 액션 -->
  <StandbyReady_Hover SkillKey="@STANDBY" CoolTime="Continue" Animation="ani_standby_hover" StartTime="0" EndTime="2000" ActionSpeedType="None" GuardType="None">
    <!-- 체공 액션 유지할 경우 위 아래 왔다갔다 하면 호버링 -->
    <!-- 위 + 아래 묶음 총 3번 -->
    <Variable Name="Height" StartTime="100" EndTime="400" Value="Height + 0.8" />
    <Variable Name="Height" StartTime="401" EndTime="700" Value="Height - 0.8" />

    <Variable Name="Height" StartTime="701" EndTime="1000" Value="Height + 0.8" />
    <Variable Name="Height" StartTime="1001" EndTime="1300" Value="Height - 0.8" />

    <Variable Name="Height" StartTime="1301" EndTime="1600" Value="Height + 0.8" />
    <Variable Name="Height" StartTime="1601" EndTime="1900" Value="Height - 0.8" />
    
    <!-- 체공 상태에서 이동 가능 -->
    <!-- 이동속도는 고정값, 액션이 변경되지 않기 때문에 Dir 저장하지 않고 입력값 바로 사용 -->
    <Move Speed="100" Direction="getPlayerDirection()" />

    <NormalBranch StartTime="0" EndTime="ActionEnd()">
      <!-- 체공 액션 자신으로 다시 브랜치하지 않도록 StandbyReadyBranch_Func 대신 피니시 줄만 둠 -->
      <Branch ActionName="StandbyReady_Finish" Condition="StandbyReady_FinishAttack == True &amp;&amp; !CheckBuff(@STANDBY_BUFF)" />
      <Branch ActionName="StandbyReady_Flash" Condition="Skill_@FLASH || (KeyDown &amp;&amp; Skill_@FLASH)" />
      <Branch ActionName="StandbyReady_Ice" Condition="Skill_@ICE || (KeyDown &amp;&amp; Skill_@ICE)" />

      <!-- 스바레 상태에서도 스킬 사용 가능 -->
      <Branch ActionName="OpenFire" Condition="Skill_@OPENFIRE &amp;&amp; NitroStock >= 1" />
      <Branch ActionName="AirAttack" Condition="Attack" />

      <!-- 안전장치: 1.9~2초는 호버링 애니로 정지, 그 사이 버프가 꺼지면 위 피니시 줄로 나감 -->
      <!-- 패킷 로스 등으로 놓치면 하강으로 갔다가 하강의 스탠바이 레디 유도 줄로 바로 피니시 -->
      <Branch ActionName="Down" Condition="ActionEnd()" />
    </NormalBranch>
  </StandbyReady_Hover>

  <!-- 스탠바이 레디 피니시 액션 -->
  <!-- 영상으로 확인했을 때 딜레이가 조금 있어서 공격 타이밍 수정 -->
  <StandbyReady_Finish SkillKey="@STANDBY" CoolTime="Continue" Animation="ani_standby_finish" StartTime="0" EndTime="" ActionSpeedType="CastSpeed" GuardType="Invincible">
    <!-- 피니시 공격 제어용 변수 초기화 -->
    <Variable Name="StandbyReady_FinishAttack" StartTime="0" Value="False" />

    <!-- 피니시 공격 적용 -->
    <!-- 반지름 600px의 범위 1타격 -->
    <AttackFrame AttackType="AttackRange" TargetType="Enemy" StartTime="100" RangeType="Round" AttackRange="600" AttackAngle="360" Offset="550, 0, 0">
      <BuffFrame SkillKey="@STANDBY" BuffIndex="0" />
    </AttackFrame>
    
    <!-- 액션 구조 상 스탠바이 레디 피니시 액션에서 강제 착지할만큼 지상으로 내려올 수 없기 때문에 강제 착지 제거 -->

    <NormalBranch StartTime="100" EndTime="ActionEnd()">
      <NitroDownBranch_Func />
      <AirBranch_Func />
      <Branch ActionName="Down" Condition="ActionEnd()" />
    </NormalBranch>
  </StandbyReady_Finish>

  <!-- ===================== 버스터 샷 ===================== -->

  <!-- 양손 사격 공용 애니(ani_shoot). 상세 수치는 스킬 조회(API) 후 기입 -->
  <!-- 지상·공중 공용 액션: 끝나면 공중이면 하강, 지상이면 대기 -->
  <BusterShot SkillKey="@BUSTER" CoolTime="getSkillCoolTime(@BUSTER)" Animation="ani_shoot" StartTime="0" EndTime="" ActionSpeedType="" GuardType="None">
    <AttackFrame AttackType="" TargetType="Enemy" StartTime="">
      <BuffFrame SkillKey="@BUSTER" BuffIndex="" />
    </AttackFrame>

    <NormalBranch StartTime="" EndTime="ActionEnd()">
      <Branch ActionName="Down" Condition="ActionEnd() &amp;&amp; Height > 0" />
      <Branch ActionName="Idle" Condition="ActionEnd()" />
    </NormalBranch>
  </BusterShot>

</ActionScript>
