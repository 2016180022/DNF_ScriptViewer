    <!-- 스탠바이 레디 버프 보유 중에는 반동 없음 -->
    <Move StartTime="" Distance="10" Direction="-getPlayerDirection()" Condition="!CheckBuff(@STANDBY_BUFF)" />
    <Variable Name="Height" StartTime="" Value="Height + 5" Condition="!CheckBuff(@STANDBY_BUFF)" />

    <!-- Loop값과 관계 없이 지상과 가까워지면 강제로 착지 -->
    <ForceLanding_Func />

    <!-- 평타가 나가야 브랜치 가능 -->
    <NormalBranch StartTime="" EndTime="ActionEnd()">
      <Branch ActionName="AirAttack" Condition="(Attack || KeyDown) &amp;&amp; LoopCount() &lt; 16" />
      
