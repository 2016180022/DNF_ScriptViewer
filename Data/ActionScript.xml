      <Branch ActionName="StandbyReady_Hover" Condition="ActionEnd() &amp;&amp; CheckBuff(@STANDBY_BUFF)" />
      <!-- ActionEnd() 조건의 브랜치는 반드시 Normal에 있어야 함 -->
      <Branch ActionName="Down" Condition="ActionEnd()" />
    </NormalBranch>

