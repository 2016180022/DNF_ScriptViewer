<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.7" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DNF_ScriptViewer.Core\DNF_ScriptViewer.Core.csproj" />
  </ItemGroup>

  <!--
    툴 데이터 원본은 레포 Data/ 하나. 빌드할 때마다 wwwroot/Data/로 복사해 배포물에 포함 (복사본은 레포 제외).
    링크(LinkBase) 방식은 개발 서버가 레포 밖 경로를 찾지 못해 빈 응답을 줘서 복사로 함 (2026-11-20)
  -->
  <ItemGroup>
    <ToolData Include="..\..\Data\**\*.xml" />
  </ItemGroup>
  <Target Name="CopyToolData" BeforeTargets="BeforeBuild">
    <RemoveDir Directories="wwwroot\Data" />
    <Copy SourceFiles="@(ToolData)" DestinationFiles="@(ToolData->'wwwroot\Data\%(RecursiveDir)%(Filename)%(Extension)')" />
    <ItemGroup>
      <Content Remove="wwwroot\Data\**" />
      <Content Include="wwwroot\Data\**" />
    </ItemGroup>
  </Target>

</Project>
